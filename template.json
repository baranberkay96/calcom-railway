{
  "name": "Cal.com 6.2 Scheduling Platform (Postgres, Scheduler)",
  "idSeed": "Cal.com 6.2 Scheduling Platform (Postgres, Scheduler)",
  "description": "Open-source Calendly alternative with booking reminders and an admin login.",
  "category": "Other",
  "tags": [
    "calcom",
    "cal.com",
    "scheduling",
    "calendly-alternative",
    "booking",
    "calendar",
    "appointments",
    "self-hosted"
  ],
  "image": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/cal-com.svg",
  "upstream": {
    "repo": "calcom/cal.diy (formerly calcom/cal.com)",
    "version": "v6.2.0",
    "images": {
      "calcom": "calcom/cal.com:v6.2.0@sha256:ace3bb1219fb7306585ab9f4d94d41af7ee064c343db0498173436bbe857bd49 (released 2026-03-02, latest published image)",
      "scheduler": "curlimages/curl:8.23.0@sha256:3fb7e13e5d179a845c97d78204f3f1064d1907037f26a3ebf91710571151fd93",
      "postgres": "ghcr.io/railwayapp-templates/postgres-ssl:18.6@sha256:4fc833b43d2aaf6ecc9b18615f5533602b723a32d0e2efe2dae8ca0f7217c863 (= :18)"
    },
    "checked": "2026-11-20"
  },
  "services": {
    "Calcom": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/cal-com.svg",
      "source": {
        "repo": "baranberkay96/calcom-railway",
        "rootDirectory": "/services/calcom"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": "/auth/login",
      "healthcheckTimeout": 1200,
      "restartPolicyType": "ALWAYS",
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": true,
      "targetPort": 3000,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "PORT": {
          "defaultValue": "3000",
          "description": "Port of the Cal.com web app (public domain target and healthcheck).",
          "required": false
        },
        "NEXT_PUBLIC_WEBAPP_URL": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public URL of Cal.com; replaced into the built app at start. Change it when you add a custom domain.",
          "required": false
        },
        "NEXTAUTH_URL": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Sign-in callback URL; keep it equal to NEXT_PUBLIC_WEBAPP_URL.",
          "required": false
        },
        "NEXTAUTH_SECRET": {
          "defaultValue": "${{secret(48, \"abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789\")}}",
          "description": "Signs sessions. Keep it stable; changing it signs everyone out.",
          "required": false
        },
        "CALENDSO_ENCRYPTION_KEY": {
          "defaultValue": "${{secret(32, \"abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789\")}}",
          "description": "32-character AES key that encrypts stored app credentials. Never change it after setup.",
          "required": false
        },
        "DATABASE_URL": {
          "defaultValue": "${{Postgres.DATABASE_URL}}",
          "description": "PostgreSQL connection over the private network. Migrations run on start.",
          "required": false
        },
        "DATABASE_DIRECT_URL": {
          "defaultValue": "${{Postgres.DATABASE_URL}}",
          "description": "Direct PostgreSQL connection for migrations.",
          "required": false
        },
        "CRON_API_KEY": {
          "defaultValue": "${{secret(32, \"abcdef0123456789\")}}",
          "description": "Key the Scheduler uses for reminder and webhook cron endpoints.",
          "required": false
        },
        "CRON_SECRET": {
          "defaultValue": "${{secret(32, \"abcdef0123456789\")}}",
          "description": "Bearer secret the Scheduler uses for the background task queue.",
          "required": false
        },
        "CAL_ADMIN_EMAIL": {
          "defaultValue": "admin@example.com",
          "description": "E-mail (login) of the first admin, created on the first start before the site opens.",
          "required": false
        },
        "CAL_ADMIN_USERNAME": {
          "defaultValue": "admin",
          "description": "Username of the first admin (public booking links use it).",
          "required": false
        },
        "CAL_ADMIN_NAME": {
          "defaultValue": "Administrator",
          "description": "Full name of the first admin (3+ characters).",
          "required": false
        },
        "CAL_ADMIN_PASSWORD": {
          "defaultValue": "Cal${{secret(20, \"abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789\")}}9x",
          "description": "Password of the first admin: 15+ characters with upper- and lower-case letters and a digit (Cal.com's admin rule). Generated; read it here to log in.",
          "required": false
        },
        "CAL_ADMIN_RESET_PASSWORD": {
          "defaultValue": "false",
          "description": "true = on the next start, set the password of CAL_ADMIN_EMAIL to CAL_ADMIN_PASSWORD. Set back to false afterwards.",
          "required": false
        },
        "NEXT_PUBLIC_DISABLE_SIGNUP": {
          "defaultValue": "true",
          "description": "true = no public sign-up page; the admin adds users. Set to false to let anyone register.",
          "required": false
        },
        "CALCOM_TELEMETRY_DISABLED": {
          "defaultValue": "1",
          "description": "Turn off Cal.com's anonymous usage telemetry.",
          "required": false
        },
        "EMAIL_FROM": {
          "defaultValue": "",
          "description": "Optional sender address for booking e-mails, e.g. bookings@example.com.",
          "required": false
        },
        "EMAIL_FROM_NAME": {
          "defaultValue": "Cal.com",
          "description": "Sender name for e-mails.",
          "required": false
        },
        "RESEND_API_KEY": {
          "defaultValue": "",
          "description": "Optional Resend API key: sends booking e-mails over HTTPS (works on every Railway plan).",
          "required": false
        },
        "EMAIL_SERVER_HOST": {
          "defaultValue": "",
          "description": "Optional SMTP server instead of Resend (outbound SMTP needs Railway Pro).",
          "required": false
        },
        "EMAIL_SERVER_PORT": {
          "defaultValue": "",
          "description": "Optional SMTP port, e.g. 587.",
          "required": false
        },
        "EMAIL_SERVER_USER": {
          "defaultValue": "",
          "description": "Optional SMTP user.",
          "required": false
        },
        "EMAIL_SERVER_PASSWORD": {
          "defaultValue": "",
          "description": "Optional SMTP password.",
          "required": false
        }
      }
    },
    "Scheduler": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/cal-com.svg",
      "source": {
        "repo": "baranberkay96/calcom-railway",
        "rootDirectory": "/services/scheduler"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ALWAYS",
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "CALCOM_INTERNAL_URL": {
          "defaultValue": "http://${{Calcom.RAILWAY_PRIVATE_DOMAIN}}:${{Calcom.PORT}}",
          "description": "Cal.com on the private network.",
          "required": false
        },
        "CRON_SECRET": {
          "defaultValue": "${{Calcom.CRON_SECRET}}",
          "description": "Reference to Cal.com's CRON_SECRET.",
          "required": false
        },
        "CRON_API_KEY": {
          "defaultValue": "${{Calcom.CRON_API_KEY}}",
          "description": "Reference to Cal.com's CRON_API_KEY.",
          "required": false
        },
        "SCHEDULER_START_DELAY": {
          "defaultValue": "120",
          "description": "Seconds to wait after start before the first call.",
          "required": false
        }
      }
    },
    "Postgres": {
      "icon": "https://devicons.railway.app/i/postgresql.svg",
      "source": {
        "image": "ghcr.io/railwayapp-templates/postgres-ssl:18.6@sha256:4fc833b43d2aaf6ecc9b18615f5533602b723a32d0e2efe2dae8ca0f7217c863"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/var/lib/postgresql/data"
      },
      "variables": {
        "PGDATA": {
          "defaultValue": "/var/lib/postgresql/data/pgdata",
          "description": "Location where the database will be initialized",
          "required": false
        },
        "PGHOST": {
          "defaultValue": "${{RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Railway Private Domain Name.",
          "required": false
        },
        "PGPORT": {
          "defaultValue": "5432",
          "description": "Port to connect to Postgres.",
          "required": false
        },
        "PGUSER": {
          "defaultValue": "${{ POSTGRES_USER }}",
          "description": "Required variable for Data panel",
          "required": false
        },
        "PGDATABASE": {
          "defaultValue": "${{POSTGRES_DB}}",
          "description": "Required variable for the data panel.",
          "required": false
        },
        "PGPASSWORD": {
          "defaultValue": "${{POSTGRES_PASSWORD}}",
          "description": "Required variable for Data panel",
          "required": false
        },
        "POSTGRES_DB": {
          "defaultValue": "railway",
          "description": "Default database created when image is started.",
          "required": false
        },
        "DATABASE_URL": {
          "defaultValue": "postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}",
          "description": "Private connection URL used by Cal.com.",
          "required": false
        },
        "POSTGRES_USER": {
          "defaultValue": "postgres",
          "description": "User to connect to Postgres DB",
          "required": false
        },
        "SSL_CERT_DAYS": {
          "defaultValue": "820",
          "description": "SSL certificate expiry in days.",
          "required": false
        },
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{ secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\") }}",
          "description": "Password to connect to DB",
          "required": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "60",
          "description": "Allow Postgres to cleanly shut down",
          "required": false
        }
      }
    }
  },
  "buckets": []
}